<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>cn.minglg.interview</groupId>
    <artifactId>starters</artifactId>
    <version>1.0.0</version>
    <packaging>pom</packaging>
    <name>starters</name>
    <description>AI模拟面试系统 - Starter模块集合</description>

    <modules>
        <module>authentication-spring-boot-autoconfigure</module>
        <module>authentication-spring-boot-starter</module>
        <module>ai-spring-boot-autoconfigure</module>
        <module>ai-spring-boot-starter</module>
    </modules>

    <properties>
        <java.version>17</java.version>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <hutool.version>5.8.39</hutool.version>
        <jwt.tool.version>4.5.0</jwt.tool.version>
        <spring.boot.version>3.5.6</spring.boot.version>
        <ai.alibaba.version>1.0.0.3</ai.alibaba.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <!-- 依赖管理 -->
    <dependencyManagement>
        <dependencies>
            <!--springboot版本管理-->
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-starter-parent</artifactId>
                <version>${spring.boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!--hutool工具包管理-->
            <dependency>
                <groupId>cn.hutool</groupId>
                <artifactId>hutool-bom</artifactId>
                <version>${hutool.version}</version>
                <type>pom</type>
                <!-- 注意这里是import -->
                <scope>import</scope>
            </dependency>

            <!-- 阿里云AI依赖管理 -->
            <dependency>
                <groupId>com.alibaba.cloud.ai</groupId>
                <artifactId>spring-ai-alibaba-bom</artifactId>
                <version>${ai.alibaba.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!--jwt相关依赖-->
            <dependency>
                <groupId>com.auth0</groupId>
                <artifactId>java-jwt</artifactId>
                <version>${jwt.tool.version}</version>
            </dependency>

            <!-- 子模块依赖管理 -->
            <dependency>
                <groupId>cn.minglg.interview</groupId>
                <artifactId>authentication-spring-boot-autoconfigure</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>cn.minglg.interview</groupId>
                <artifactId>authentication-spring-boot-starter</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>cn.minglg.interview</groupId>
                <artifactId>ai-spring-boot-autoconfigure</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>cn.minglg.interview</groupId>
                <artifactId>ai-spring-boot-starter</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>